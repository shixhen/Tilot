{
  "name": "tilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @tilot/desktop",
    "desktop": "npm run tauri --workspace @tilot/desktop -- dev",
    "test:desktop": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  }
}
